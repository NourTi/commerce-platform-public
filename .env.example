# Database and local application session
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-value

# Customer authentication: Auth0 Regular Web Application
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET
AUTH0_SESSION_SECRET=replace-with-a-different-long-random-value
AUTH0_APP_BASE_URL=https://YOUR_PUBLIC_DOMAIN

# Transactional email: Mailjet
MAILJET_API_KEY=YOUR_MAILJET_API_KEY
MAILJET_SECRET_KEY=YOUR_MAILJET_SECRET_KEY
MAILJET_SENDER_EMAIL=verified-sender@example.com
MAILJET_SENDER_NAME=Commerce Platform

# Platform/runtime values required by the managed template or an equivalent implementation
VITE_APP_ID=YOUR_APP_ID
VITE_OAUTH_PORTAL_URL=https://YOUR_MERCHANT_AUTHORITY
OAUTH_SERVER_URL=https://YOUR_MERCHANT_AUTHORITY
VITE_APP_TITLE=Commerce Platform
